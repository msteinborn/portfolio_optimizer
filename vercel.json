{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "uv venv /tmp/flet-venv && uv pip install --python /tmp/flet-venv/bin/python 'flet>=1.0.0' flet-cli flet-web",
  "buildCommand": "/tmp/flet-venv/bin/flet publish main.py --app-name 'International Equity Portfolio Optimizer' --app-short-name 'PortfolioOpt'",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
